#!/usr/bin/env python3
"""chapman-shell themes: palette, glass settings and wallpapers rendered into app files.

chapman-shell theme                       list themes, * marks the current one
chapman-shell theme <id>                  apply a theme
chapman-shell theme --json                themes for the switcher
chapman-shell theme new <id> [<from>]     copy a theme, the current one by default, into a new user theme
chapman-shell theme import <scheme> [<id>]  make a theme from a ghostty color scheme name or file
chapman-shell theme delete <id>           move a user theme with its wallpapers to the trash
chapman-shell schemes --json              ghostty color schemes available for import
chapman-shell wallpaper <path>            change the wallpaper inside the current theme
chapman-shell wallpaper add <path>...     copy images into the current theme's wallpapers and show the first
chapman-shell wallpaper dir               print the current theme's wallpaper folder
chapman-shell wallpaper remove <path>     move a wallpaper of the current theme to the trash
chapman-shell reapply                     render the current theme again, glass if none
chapman-shell ipc <target> <fn>...        call the running shell over quickshell ipc
"""

import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parent.parent
SHELL_DIR = ROOT / "shell"
DATA = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "chapman-shell"
TRASH = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share") / "Trash"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "chapman-shell"
THEME_DIRS = (DATA / "themes", ROOT / "themes")
TARGETS = CONFIG / "targets.json"
STATE = Path(os.environ.get("CHAPMAN_THEME_STATE") or Path.home() / ".local/state/theme")
CURRENT = STATE / "current.json"
COLORS = STATE / "colors.json"
DEFAULT_THEME = "glass"
IMAGE_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".bmp"}
PLACEHOLDER = re.compile(r"\{\{([\w.]+)\}\}")
SWATCHES = ["primary", "surface", "on_surface", "secondary", "tertiary", "error"]
ZED_ALPHA_GAP = 0.12


def theme_ids():
    return sorted({path.parent.name for root in THEME_DIRS for path in root.glob("*/theme.json")})


def theme_file(theme_id):
    return next(root / theme_id / "theme.json" for root in THEME_DIRS if (root / theme_id / "theme.json").is_file())


def wallpaper_dir(theme_id):
    return DATA / "themes" / theme_id / "wallpapers"


def wallpapers(theme_id):
    images = [path for root in THEME_DIRS for path in (root / theme_id / "wallpapers").glob("*")]
    return sorted(str(path) for path in images if path.suffix.lower() in IMAGE_SUFFIXES)


def load_theme(theme_id):
    if theme_id not in theme_ids():
        sys.exit(f"chapman-shell: unknown theme {theme_id}, have: {' '.join(theme_ids())}")
    theme = json.loads(theme_file(theme_id).read_text())
    theme["wallpapers"] = wallpapers(theme_id)
    return theme


def current():
    return json.loads(CURRENT.read_text()) if CURRENT.exists() else {}


def alpha_hex(opacity):
    return f"{round(max(0.0, opacity) * 255):02x}"


def rgb(color):
    return ",".join(str(int(color[i:i + 2], 16)) for i in (1, 3, 5))


def mix(color, other, amount):
    channels = [round(int(color[i:i + 2], 16) * (1 - amount) + int(other[i:i + 2], 16) * amount) for i in (1, 3, 5)]
    return "#" + "".join(f"{channel:02x}" for channel in channels)


def context(theme_id, theme, wallpaper):
    glass = dict(theme["glass"])
    glass["alpha"] = alpha_hex(glass["opacity"])
    glass["alpha_zed"] = alpha_hex(glass["opacity"] - ZED_ALPHA_GAP)
    return {
        "id": theme_id,
        "name": theme["name"],
        "variant": theme["variant"],
        "colors": theme["colors"],
        "terminal": theme["terminal"],
        "glass": glass,
        "wallpaper": wallpaper,
    }


def lookup(values, path):
    node = values
    for part in path.split("."):
        node = node[int(part)] if isinstance(node, list) else node[part]
    return node


def render(template, values):
    def replace(match):
        path = match.group(1)
        if path.endswith(".rgb"):
            return rgb(lookup(values, path[:-4]))
        return str(lookup(values, path))

    return PLACEHOLDER.sub(replace, template)


def targets():
    return json.loads(TARGETS.read_text()) if TARGETS.exists() else {}


def render_targets(values):
    for name, target in targets().items():
        if target.get("template"):
            path = Path(target.get("path") or STATE / name).expanduser()
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(render(Path(target["template"]).read_text(), values))


def run_targets():
    for target in targets().values():
        if target.get("reload"):
            subprocess.run(["sh", "-c", target["reload"]], capture_output=True, check=False)
        if target.get("hook"):
            subprocess.run([target["hook"], str(COLORS)], capture_output=True, check=False)


def apply(theme_id, wallpaper=None):
    theme = load_theme(theme_id)
    wallpaper = wallpaper or next(iter(theme["wallpapers"]), "")
    STATE.mkdir(parents=True, exist_ok=True)
    values = context(theme_id, theme, wallpaper)
    COLORS.write_text(json.dumps(values, indent=2) + "\n")
    remembered = {**current().get("remembered", {}), theme_id: wallpaper}
    CURRENT.write_text(json.dumps({"theme": theme_id, "wallpaper": wallpaper, "remembered": remembered}) + "\n")
    render_targets(values)
    run_targets()


def switch_theme(theme_id):
    wallpaper = current().get("remembered", {}).get(theme_id)
    if wallpaper not in load_theme(theme_id)["wallpapers"]:
        wallpaper = None
    apply(theme_id, wallpaper)
    print(theme_id)


def current_theme():
    chosen = current()
    if not chosen:
        sys.exit("chapman-shell: no theme applied yet")
    return chosen["theme"]


def switch_wallpaper(path):
    theme_id = current_theme()
    if not Path(path).is_file():
        sys.exit(f"chapman-shell: {path} is not a file")
    apply(theme_id, str(Path(path).resolve()))


def add_wallpapers(paths):
    theme_id = current_theme()
    folder = wallpaper_dir(theme_id)
    folder.mkdir(parents=True, exist_ok=True)
    copies = [shutil.copy2(Path(path).expanduser(), folder) for path in paths if Path(path).expanduser().is_file()]
    if not copies:
        sys.exit("chapman-shell: no image files given")
    apply(theme_id, str(copies[0]))
    print(folder)


def write_user_theme(theme_id, theme):
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", theme_id):
        sys.exit(f"chapman-shell: theme id {theme_id} must be lower case letters, digits and dashes")
    folder = DATA / "themes" / theme_id
    if (folder / "theme.json").exists():
        sys.exit(f"chapman-shell: theme {theme_id} already exists in {folder}")
    (folder / "wallpapers").mkdir(parents=True, exist_ok=True)
    theme.pop("wallpapers", None)
    (folder / "theme.json").write_text(json.dumps(theme, indent=2, ensure_ascii=False) + "\n")
    apply(theme_id)
    print(theme_id)


def new_theme(theme_id, source=None):
    source = source or current().get("theme", DEFAULT_THEME)
    theme = load_theme(source)
    theme["name"] = theme_id.replace("-", " ").title()
    write_user_theme(theme_id, theme)


def ghostty_schemes():
    ghostty = shutil.which("ghostty")
    folders = [CONFIG.parent / "ghostty/themes"]
    if ghostty:
        folders.append(Path(ghostty).resolve().parent.parent / "share/ghostty/themes")
    return {path.name: path for folder in folders if folder.is_dir() for path in sorted(folder.iterdir())}


def parse_scheme(text):
    values, palette = {}, {}
    for line in text.splitlines():
        key, _, value = (part.strip() for part in line.partition("="))
        if key == "palette":
            index, _, color = value.partition("=")
            palette[int(index)] = color.strip()
        elif key:
            values[key] = value
    return values, [palette[index] for index in range(16)]


def luminance(color):
    red, green, blue = (int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))
    return 0.2126 * red + 0.7152 * green + 0.0722 * blue


def scheme_theme(name, text):
    values, palette = parse_scheme(text)
    bg, fg = values["background"], values["foreground"]
    colors = {
        "background": bg,
        "surface": mix(bg, fg, 0.05),
        "surface_dim": mix(bg, "#000000", 0.3),
        "surface_bright": mix(bg, fg, 0.18),
        "surface_container": mix(bg, fg, 0.1),
        "surface_container_high": mix(bg, fg, 0.15),
        "surface_container_highest": mix(bg, fg, 0.22),
        "on_surface": fg,
        "on_surface_variant": mix(fg, bg, 0.35),
        "outline": mix(fg, bg, 0.5),
        "outline_variant": mix(bg, fg, 0.2),
        "primary": palette[12],
        "on_primary": bg,
        "primary_container": mix(bg, palette[12], 0.3),
        "primary_fixed": palette[4],
        "secondary": palette[13],
        "secondary_container": mix(bg, palette[13], 0.3),
        "tertiary": palette[14],
        "tertiary_fixed": palette[6],
        "error": palette[9],
        "warning": palette[11],
        "info": palette[12],
    }
    terminal = {
        "background": bg,
        "foreground": fg,
        "cursor": values.get("cursor-color", fg),
        "selection_background": values.get("selection-background", colors["surface_bright"]),
        "selection_foreground": values.get("selection-foreground", fg),
        "palette": palette,
    }
    glass = load_theme(DEFAULT_THEME)["glass"]
    variant = "dark" if luminance(bg) < 0.5 else "light"
    return {"name": name, "variant": variant, "glass": glass, "colors": colors, "terminal": terminal}


def import_scheme(scheme, theme_id=None):
    path = Path(scheme).expanduser()
    path = path if path.is_file() else ghostty_schemes().get(scheme)
    if path is None:
        sys.exit(f"chapman-shell: no ghostty scheme or file {scheme}")
    theme_id = theme_id or re.sub(r"[^a-z0-9]+", "-", path.name.lower()).strip("-")
    write_user_theme(theme_id, scheme_theme(path.name, path.read_text()))


def trash(path):
    files, info = TRASH / "files", TRASH / "info"
    files.mkdir(parents=True, exist_ok=True)
    info.mkdir(parents=True, exist_ok=True)
    name, index = path.name, 1
    while (files / name).exists() or (info / f"{name}.trashinfo").exists():
        index += 1
        name = f"{path.stem}.{index}{path.suffix}"
    stamp = datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    (info / f"{name}.trashinfo").write_text(f"[Trash Info]\nPath={quote(str(path))}\nDeletionDate={stamp}\n")
    shutil.move(path, files / name)


def delete_theme(theme_id):
    folder = DATA / "themes" / theme_id
    if not folder.is_dir():
        sys.exit(f"chapman-shell: {theme_id} is not a user theme")
    trash(folder.resolve())
    chosen = current()
    chosen.get("remembered", {}).pop(theme_id, None)
    CURRENT.write_text(json.dumps(chosen) + "\n")
    if chosen.get("theme") == theme_id:
        apply(DEFAULT_THEME)


def remove_wallpaper(path):
    theme_id = current_theme()
    path = Path(path).expanduser().resolve()
    if path.parent != wallpaper_dir(theme_id).resolve():
        sys.exit(f"chapman-shell: {path} is not in {wallpaper_dir(theme_id)}")
    trash(path)
    wallpaper = current().get("wallpaper")
    apply(theme_id, None if wallpaper == str(path) else wallpaper)


def schemes_json():
    entries = []
    for name, path in ghostty_schemes().items():
        values, palette = parse_scheme(path.read_text())
        entries.append({"name": name, "background": values.get("background"), "palette": palette})
    print(json.dumps(entries, ensure_ascii=False))


def listing():
    now = current().get("theme")
    for theme_id in theme_ids():
        print(("* " if theme_id == now else "  ") + theme_id)


def listing_json():
    now = current().get("theme")
    entries = []
    for theme_id in theme_ids():
        theme = load_theme(theme_id)
        entries.append({
            "id": theme_id,
            "name": theme["name"],
            "current": theme_id == now,
            "user": (DATA / "themes" / theme_id / "theme.json").exists(),
            "wallpapers": theme["wallpapers"],
            "colors": {key: theme["colors"][key] for key in SWATCHES},
        })
    print(json.dumps(entries, ensure_ascii=False))


def theme_command(args):
    if not args:
        listing()
    elif args == ["--json"]:
        listing_json()
    elif args[0] == "new" and len(args) in (2, 3):
        new_theme(*args[1:])
    elif args[0] == "import" and len(args) in (2, 3):
        import_scheme(*args[1:])
    elif args[0] == "delete" and len(args) == 2:
        delete_theme(args[1])
    elif len(args) == 1:
        switch_theme(args[0])
    else:
        sys.exit(__doc__.strip())


def wallpaper_command(args):
    if args == ["dir"]:
        print(wallpaper_dir(current_theme()))
    elif args[:1] == ["add"] and len(args) > 1:
        add_wallpapers(args[1:])
    elif args[:1] == ["remove"] and len(args) == 2:
        remove_wallpaper(args[1])
    elif len(args) == 1:
        switch_wallpaper(args[0])
    else:
        sys.exit(__doc__.strip())


def main(args):
    if args[:1] == ["theme"]:
        theme_command(args[1:])
    elif args[:1] == ["wallpaper"]:
        wallpaper_command(args[1:])
    elif args == ["schemes", "--json"]:
        schemes_json()
    elif args == ["reapply"]:
        apply(current().get("theme", DEFAULT_THEME), current().get("wallpaper"))
    elif args[:1] == ["ipc"] and len(args) >= 3:
        os.execvp("qs", ["qs", "-p", str(SHELL_DIR), "ipc", "call", *args[1:]])
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])

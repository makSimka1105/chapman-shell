#!/usr/bin/env python3
import sys
from urllib.parse import unquote, urlparse

from gi.repository import Gio, GLib

PORTAL = "org.freedesktop.portal.Desktop"
TOKEN = "chapman_pick"
IMAGES = [("Картинки", [(0, f"*.{suffix}") for suffix in ("png", "jpg", "jpeg", "gif", "bmp")])]

bus = Gio.bus_get_sync(Gio.BusType.SESSION)
sender = bus.get_unique_name()[1:].replace(".", "_")
request = f"/org/freedesktop/portal/desktop/request/{sender}/{TOKEN}"
loop = GLib.MainLoop()


def on_response(connection, sender_name, path, interface, signal, params):
    code, results = params.unpack()
    if code == 0:
        for uri in results.get("uris", []):
            print(unquote(urlparse(uri).path))
    loop.quit()


bus.signal_subscribe(PORTAL, "org.freedesktop.portal.Request", "Response", request, None, Gio.DBusSignalFlags.NONE, on_response)
options = {
    "handle_token": GLib.Variant("s", TOKEN),
    "multiple": GLib.Variant("b", True),
    "filters": GLib.Variant("a(sa(us))", IMAGES),
}
bus.call_sync(PORTAL, "/org/freedesktop/portal/desktop", "org.freedesktop.portal.FileChooser", "OpenFile",
              GLib.Variant("(ssa{sv})", ("", sys.argv[1] if len(sys.argv) > 1 else "Обои", options)), None, Gio.DBusCallFlags.NONE, -1, None)
loop.run()

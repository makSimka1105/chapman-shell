#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from typing import NamedTuple

HOME = Path.home()
KEYS_DIR = HOME / ".secrets/llm"
CLAUDE_CREDENTIALS = HOME / ".claude/.credentials.json"
CLAUDE_PROJECTS = HOME / ".claude/projects"
CLAUDE_PRICES = HOME / ".claude/pricing-cache.json"
CODEX_SESSIONS = HOME / ".codex/sessions"
QWEN_PROFILES = (HOME / ".local/state/qwen", HOME / ".local/share/qwen-profiles")
HERMES_DATABASE = HOME / ".hermes/state.db"
STORE = HOME / ".local/share/chapman-shell/usage-days.json"
START = HOME / ".local/share/chapman-shell/usage-start"
HISTORY = HOME / ".local/share/chapman-shell/usage-history.json"
OPENROUTER_MODELS = HOME / ".cache/chapman-shell/or-models.json"
OUTPUT = Path(os.environ["XDG_RUNTIME_DIR"]) / "chapman-usage.json"
CLAUDE_URL = "https://claude.ai/api/oauth/usage"
CLAUDE_CURL = "curl_chrome136"
LITELLM_URL = "https://litellm.data-light.ru"
OPENROUTER_URL = "https://openrouter.ai/api/v1"
TIMEOUT = 10
RECENT_DAYS = 2
WINDOW_DAYS = 7
MODEL_DAYS = 30
PRICE_CACHE_SECONDS = 86400
FIELDS = ("i", "o", "cr", "cw", "reqs", "eq")
CLAUDE_WINDOWS = (("five_hour", "5 часов"), ("seven_day", "неделя"))
CODEX_WINDOWS = (("primary", "five_hour"), ("secondary", "seven_day"))
CODEX_LABELS = {300: "5 часов", 10080: "неделя"}
CODEX_GLOB = "*/*/*/rollout-*.jsonl"
PROVIDERS = {
    "course-1": "litellm",
    "course-2": "litellm",
    "openrouter": "openrouter",
}
IGNORED_KEYS = {"hackathon"}
PROFILE_ALIASES = {"course": "course-1", "or": "openrouter", "free": "openrouter"}
SUBSCRIPTIONS = (
    {"id": "claude", "name": "Claude", "color": "#e3a15b", "provider": "anthropic"},
    {"id": "codex", "name": "ChatGPT", "color": "#9be37f", "provider": "openai"},
)
KEY_STYLES = {
    "openrouter": ("OpenRouter", "#8fb4ff"),
    "course-1": ("Курс 1", "#7fd8b4"),
    "course-2": ("Курс 2", "#c3a6f2"),
}
SPARE_COLORS = ("#f2d36b", "#6fd3e8", "#e88f6f", "#b6e06b")


class Event(NamedTuple):
    day: str
    hour: int | None
    source: str
    model: str
    fresh: int
    out: int
    read: int
    write: int
    cost: float
    rate: list | None
    calls: int


def load(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, separators=(",", ":")))
    temporary.replace(path)


def get_json(url, token):
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}", "Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.load(response)


def claude_windows(reply):
    windows = []
    for window_id, label in CLAUDE_WINDOWS:
        entry = reply.get(window_id) or {}
        used = entry.get("utilization")
        windows.append({
            "id": window_id,
            "label": label,
            "used": None if used is None else round(used / 100, 4),
            "resets_at": entry.get("resets_at"),
        })
    return windows


def claude_live():
    try:
        token = json.loads(CLAUDE_CREDENTIALS.read_text())["claudeAiOauth"]["accessToken"]
        run = subprocess.run(
            [CLAUDE_CURL, "-sS", "--max-time", str(TIMEOUT), "-H", "@-", "-H", "Accept: application/json", CLAUDE_URL],
            input=f"Authorization: Bearer {token}\n",
            capture_output=True,
            text=True,
            timeout=TIMEOUT + 5,
        )
        if run.returncode != 0:
            return {"windows": []}, f"curl error {run.returncode}"
        reply = json.loads(run.stdout)
        if "five_hour" not in reply:
            return {"windows": []}, "unexpected reply"
        return {"windows": claude_windows(reply)}, "ok"
    except FileNotFoundError:
        return {"windows": []}, "not logged in"
    except (KeyError, ValueError, subprocess.TimeoutExpired):
        return {"windows": []}, "unexpected reply"


def codex_logged_in():
    try:
        run = subprocess.run(["codex", "login", "status"], capture_output=True, text=True, timeout=TIMEOUT)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return False
    return run.returncode == 0 and "Logged in" in run.stdout + run.stderr


def codex_token_rows(path):
    with path.open() as stream:
        for line in stream:
            if '"token_count"' not in line and '"turn_context"' not in line:
                continue
            try:
                row = json.loads(line)
            except ValueError:
                continue
            if isinstance(row.get("payload"), dict):
                yield row, row["payload"]


def codex_latest_limits():
    files = sorted(CODEX_SESSIONS.glob(CODEX_GLOB), key=lambda path: path.stat().st_mtime, reverse=True)
    for path in files:
        latest = None
        for _, payload in codex_token_rows(path):
            if payload.get("type") == "token_count" and isinstance(payload.get("rate_limits"), dict):
                latest = payload["rate_limits"]
        if latest:
            return latest
    return None


def codex_label(minutes):
    if minutes in CODEX_LABELS:
        return CODEX_LABELS[minutes]
    return f"{round(minutes / 60)} ч"


def codex_windows(limits):
    windows = []
    for key, window_id in CODEX_WINDOWS:
        entry = limits.get(key)
        if not isinstance(entry, dict):
            continue
        resets_at = entry.get("resets_at")
        used = (entry.get("used_percent") or 0) / 100
        if resets_at and resets_at < time.time():
            used = 0
        windows.append({
            "id": window_id,
            "label": codex_label(entry.get("window_minutes") or 0),
            "used": round(used, 4),
            "resets_at": datetime.fromtimestamp(resets_at, timezone.utc).isoformat(timespec="seconds") if resets_at else None,
        })
    return windows


def codex_live():
    if not codex_logged_in():
        return {"windows": []}, "not logged in"
    limits = codex_latest_limits()
    if not limits:
        return {"windows": []}, "no data yet"
    return {"windows": codex_windows(limits)}, "ok"


SUBSCRIPTION_FETCHERS = {"claude": claude_live, "codex": codex_live}


def litellm_usage(token):
    try:
        info = get_json(f"{LITELLM_URL}/key/info", token)["info"]
    except urllib.error.HTTPError as error:
        if error.code != 404:
            raise
        get_json(f"{LITELLM_URL}/v1/models", token)
        return None, None
    return info.get("spend"), info.get("max_budget")


def openrouter_usage(token):
    try:
        info = get_json(f"{OPENROUTER_URL}/key", token)["data"]
    except urllib.error.HTTPError as error:
        if error.code != 404:
            raise
        info = get_json(f"{OPENROUTER_URL}/auth/key", token)["data"]
    return info.get("usage"), info.get("limit")


KEY_FETCHERS = {"litellm": litellm_usage, "openrouter": openrouter_usage}


def key_live(path):
    provider = PROVIDERS.get(path.stem, "unknown")
    live = {"spend": None, "limit": None, "remaining": None, "currency": "USD"}
    if provider == "unknown":
        return provider, live, "unknown provider"
    if provider not in KEY_FETCHERS:
        return provider, live, "no usage endpoint"
    try:
        spend, limit = KEY_FETCHERS[provider](path.read_text().strip())
    except urllib.error.HTTPError as error:
        return provider, live, "out of budget" if error.code == 402 else f"http {error.code}"
    except (urllib.error.URLError, TimeoutError):
        return provider, live, "network error"
    except (KeyError, ValueError):
        return provider, live, "unexpected reply"
    remaining = None if spend is None or limit is None else max(0, limit - spend)
    live |= {"spend": spend, "limit": limit, "remaining": remaining}
    return provider, live, "ok" if spend is not None else "active, no spend data"


def key_style(key_id, index):
    if key_id in KEY_STYLES:
        return KEY_STYLES[key_id]
    return key_id, SPARE_COLORS[index % len(SPARE_COLORS)]


def fetch_openrouter_prices():
    cached = load(OPENROUTER_MODELS, {})
    if time.time() - cached.get("at", 0) < PRICE_CACHE_SECONDS and cached.get("models"):
        return cached["models"]
    try:
        with urllib.request.urlopen(f"{OPENROUTER_URL}/models", timeout=20) as reply:
            listing = json.load(reply)["data"]
    except (OSError, ValueError, KeyError):
        return cached.get("models", {})
    models = {}
    for entry in listing:
        rate = entry.get("pricing") or {}
        models[entry["id"]] = [float(rate.get(field) or 0) * 1e6 for field in ("prompt", "completion", "input_cache_read")]
    save(OPENROUTER_MODELS, {"at": time.time(), "models": models})
    return models


def openrouter_rate(models, name):
    if name in models:
        return models[name]
    for key in sorted(models):
        if key.startswith(name):
            return models[key]
    return None


def claude_rate(prices, name):
    for family, rate in prices.items():
        if family in name:
            return [rate["input"] * 1e6, rate["output"] * 1e6, rate["cache_read"] * 1e6, rate["cache_write"] * 1e6]
    return None


def counting_start():
    try:
        return datetime.fromisoformat(START.read_text().strip())
    except (OSError, ValueError):
        return None


def local_moment(stamp):
    return datetime.fromisoformat(stamp.replace("Z", "+00:00")).astimezone()


def recent_files(root, pattern, full):
    cutoff = time.time() - RECENT_DAYS * 86400
    for path in root.glob(pattern):
        if full or path.stat().st_mtime >= cutoff:
            yield path


def claude_messages(full):
    seen = {}
    for path in recent_files(CLAUDE_PROJECTS, "**/*.jsonl", full):
        with path.open() as stream:
            for line in stream:
                if '"usage"' not in line:
                    continue
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                message = row.get("message")
                if not isinstance(message, dict) or not isinstance(message.get("usage"), dict):
                    continue
                if not message.get("model") or message["model"].startswith("<"):
                    continue
                seen[message.get("id") or row.get("uuid")] = (row["timestamp"], message["model"], message["usage"])
    return seen.values()


def claude_events(full, start):
    prices = load(CLAUDE_PRICES, {}).get("models", {})
    for stamp, model, usage in claude_messages(full):
        moment = local_moment(stamp)
        if start and moment < start:
            continue
        rate = claude_rate(prices, model)
        fresh = usage.get("input_tokens", 0)
        out = usage.get("output_tokens", 0)
        read = usage.get("cache_read_input_tokens", 0)
        write = usage.get("cache_creation_input_tokens", 0)
        long_write = (usage.get("cache_creation") or {}).get("ephemeral_1h_input_tokens", 0)
        cost = 0.0
        if rate:
            cost = (fresh * rate[0] + out * rate[1] + read * rate[2] + (write - long_write) * rate[3] + long_write * rate[0] * 2) / 1e6
        yield Event(moment.date().isoformat(), moment.hour, "claude", model, fresh, out, read, write, cost, rate, 1)


def codex_rate(models, model):
    parts = f"openai/{model}".split("-")
    while len(parts) > 1:
        rate = openrouter_rate(models, "-".join(parts))
        if rate:
            return rate
        parts.pop()
    return None


def codex_events(full, start):
    models = fetch_openrouter_prices()
    for path in recent_files(CODEX_SESSIONS, CODEX_GLOB, full):
        model = "unknown"
        seen = set()
        for row, payload in codex_token_rows(path):
            if row.get("type") == "turn_context" and payload.get("model"):
                model = payload["model"]
            if payload.get("type") != "token_count" or not isinstance(payload.get("info"), dict):
                continue
            total = json.dumps(payload["info"].get("total_token_usage"), sort_keys=True)
            usage = payload["info"].get("last_token_usage")
            moment = local_moment(row["timestamp"])
            if total in seen or not usage or start and moment < start:
                continue
            seen.add(total)
            read = usage.get("cached_input_tokens", 0)
            fresh = usage.get("input_tokens", 0) - read
            write = usage.get("cache_write_input_tokens", 0)
            out = usage.get("output_tokens", 0) + usage.get("reasoning_output_tokens", 0)
            rate = codex_rate(models, model)
            cost = (fresh * rate[0] + read * rate[2] + write * rate[0] + out * rate[1]) / 1e6 if rate else 0.0
            yield Event(moment.date().isoformat(), moment.hour, "codex", model, fresh, out, read, write, cost, rate, 1)


def profile_sources(key_ids):
    for profile in sorted(path for root in QWEN_PROFILES for path in root.glob("*/projects")):
        name = profile.parent.name
        source = name if name in key_ids else PROFILE_ALIASES.get(name)
        if source in key_ids:
            yield profile, source


def qwen_rows(root, full):
    for path in recent_files(root, "*/chats/*.jsonl", full):
        with path.open() as stream:
            for line in stream:
                if "api_response" not in line:
                    continue
                try:
                    row = json.loads(line)
                except ValueError:
                    continue
                event = (row.get("systemPayload") or {}).get("uiEvent") or {}
                if event.get("event.name") == "qwen-code.api_response":
                    yield row, event


def qwen_events(full, key_ids, start):
    models = fetch_openrouter_prices()
    seen = set()
    for root, source in profile_sources(key_ids):
        for row, event in qwen_rows(root, full):
            moment = local_moment(row["timestamp"])
            if row["uuid"] in seen or start and moment < start:
                continue
            seen.add(row["uuid"])
            model = event.get("model") or "unknown"
            total_in = event.get("input_token_count", 0)
            read = event.get("cached_content_token_count", 0)
            out = event.get("output_token_count", 0)
            rate = openrouter_rate(models, model)
            cost = ((total_in - read) * rate[0] + read * rate[2] + out * rate[1]) / 1e6 if rate else 0.0
            yield Event(moment.date().isoformat(), moment.hour, source, model, total_in - read, out, read, 0, cost, rate, 1)


def hermes_events(key_ids, start):
    import sqlite3
    if "openrouter" not in key_ids or not HERMES_DATABASE.exists():
        return
    try:
        base = sqlite3.connect(f"file:{HERMES_DATABASE}?mode=ro", uri=True, timeout=5)
        rows = base.execute(
            "select model, first_seen, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, "
            "estimated_cost_usd, actual_cost_usd, api_call_count from session_model_usage where billing_provider = 'openrouter'"
        ).fetchall()
    except sqlite3.Error:
        return
    models = fetch_openrouter_prices()
    totals = {}
    for model, seen, fresh, out, read, write, estimated, actual, calls in rows:
        if start and seen < start.timestamp():
            continue
        slot = totals.setdefault((datetime.fromtimestamp(seen).date().isoformat(), model), [0, 0, 0, 0, 0.0, 0])
        for index, value in enumerate((fresh, out, read, write, actual or estimated or 0.0, calls)):
            slot[index] += value
    for (day, model), (fresh, out, read, write, cost, calls) in totals.items():
        yield Event(day, None, "openrouter", model, fresh, out, read, write, cost, openrouter_rate(models, model), calls)


def merge(store, events, hours):
    today = date.today().isoformat()
    for event in events:
        entry = store.setdefault(event.day, {}).setdefault(event.source, {}).setdefault(event.model, {})
        scan = entry.setdefault("fresh", dict.fromkeys(FIELDS, 0))
        for field, value in zip(FIELDS, (event.fresh, event.out, event.read, event.write, event.calls, event.cost)):
            scan[field] += value
        if event.rate:
            entry["p"] = [round(value, 6) for value in event.rate]
        if event.hour is not None and event.day == today:
            hours.setdefault(event.source, [0] * 24)[event.hour] += 1
    settle(store)


def settle(store):
    for sources in store.values():
        for models in sources.values():
            for entry in models.values():
                scan = entry.pop("fresh", None)
                stored = sum(entry.get(field, 0) for field in ("i", "o", "cr", "cw"))
                if scan and scan["i"] + scan["o"] + scan["cr"] + scan["cw"] >= stored:
                    entry.update(scan)
                for field in FIELDS:
                    entry.setdefault(field, 0)


def add_model(models, name, entry):
    row = models.setdefault(name, dict.fromkeys(FIELDS, 0) | {"model": name, "p": entry.get("p")})
    for field in FIELDS:
        row[field] += entry[field]


def finish_models(models):
    rows = sorted(models.values(), key=lambda row: -row["eq"])
    for row in rows:
        row["i"] += row["cr"] + row["cw"]
        row["eq"] = round(row["eq"], 6)
        if row["p"] and len(row["p"]) != 4:
            row["p"] = row["p"][:2]
    return rows


def source_tokens(store, window, source, hours):
    daily = {field: [0] * WINDOW_DAYS for field in FIELDS}
    models = {}
    for index, day in enumerate(window):
        for name, entry in store.get(day, {}).get(source, {}).items():
            add_model(models, name, entry)
            for field in FIELDS:
                daily[field][index] += entry[field]
    daily["i"] = [fresh + read + write for fresh, read, write in zip(daily["i"], daily["cr"], daily["cw"])]
    daily["eq"] = [round(value, 6) for value in daily["eq"]]
    return {"daily": daily, "hourly": hours.get(source, [0] * 24), "eq_7d": round(sum(daily["eq"]), 6), "models": finish_models(models)}


def month_buckets(store, source_ids):
    months = {}
    for day, sources in sorted(store.items()):
        bucket = months.setdefault(day[:7], {"m": day[:7], "days": set()})
        bucket["days"].add(day)
        for source in source_ids:
            slot = bucket.setdefault(source, dict.fromkeys(FIELDS, 0))
            for entry in sources.get(source, {}).values():
                for field in FIELDS:
                    slot[field] += entry[field]
    for bucket in months.values():
        bucket["days"] = len(bucket["days"])
        for source in source_ids:
            slot = bucket[source]
            bucket[source] = {"i": slot["i"] + slot["cr"] + slot["cw"], "o": slot["o"], "eq": round(slot["eq"], 6)}
    return list(months.values())


def day_list(first, count):
    return [(first + timedelta(days=offset)).isoformat() for offset in range(count)]


def day_totals(books, day, source):
    totals = dict.fromkeys(FIELDS, 0)
    for book in books:
        for entry in book.get(day, {}).get(source, {}).values():
            for field in FIELDS:
                totals[field] += entry[field]
    totals["i"] += totals.pop("cr") + totals.pop("cw")
    return totals


def limit_start(source, today):
    window = next((entry for entry in source["live"]["windows"] if entry["id"] == "seven_day" and entry["resets_at"]), None)
    if not window:
        return today - timedelta(days=WINDOW_DAYS - 1)
    reset = datetime.fromisoformat(window["resets_at"]).astimezone()
    now = datetime.now().astimezone()
    while reset <= now:
        reset += timedelta(days=7)
    return (reset - timedelta(days=7)).date()


def limit_weeks(books, source, start):
    used = [day for book in books for day, sources in book.items() if sources.get(source)]
    if not used:
        return []
    weeks = []
    begin = start
    while (begin + timedelta(days=6)).isoformat() >= min(used):
        totals = [day_totals(books, day, source) for day in day_list(begin, 7)]
        weeks.insert(0, {"from": begin.isoformat()} | {field: round(sum(total[field] for total in totals), 6) for field in ("i", "o", "reqs", "eq")})
        begin -= timedelta(days=7)
    return weeks


def recent_models(books, source, today):
    models = {}
    for day in day_list(today - timedelta(days=MODEL_DAYS - 1), MODEL_DAYS):
        for book in books:
            for name, entry in book.get(day, {}).get(source, {}).items():
                add_model(models, name, entry)
    return finish_models(models)


def subscription_history(books, source, today):
    start = limit_start(source, today)
    days = day_list(start, WINDOW_DAYS)
    totals = [day_totals(books, day, source["id"]) for day in days]
    return {
        "days": days,
        "i": [total["i"] for total in totals],
        "o": [total["o"] for total in totals],
        "weeks": limit_weeks(books, source["id"], start),
        "models": recent_models(books, source["id"], today),
    }


def build_sources(key_paths):
    sources = []
    for subscription in SUBSCRIPTIONS:
        live, status = SUBSCRIPTION_FETCHERS[subscription["id"]]()
        sources.append(subscription | {"kind": "subscription", "live": live, "status": status})
    for index, path in enumerate(key_paths):
        name, color = key_style(path.stem, index)
        provider, live, status = key_live(path)
        sources.append({"id": path.stem, "kind": "key", "name": name, "color": color, "provider": provider, "live": live, "status": status})
    return sources


def main():
    key_paths = sorted(path for path in KEYS_DIR.glob("*.key") if path.stem not in IGNORED_KEYS)
    key_ids = {path.stem for path in key_paths}
    full = "--full" in sys.argv or not STORE.exists()
    store = load(STORE, {})
    start = counting_start()
    hours = {}
    merge(store, claude_events(full, start), hours)
    merge(store, codex_events(full, start), hours)
    merge(store, qwen_events(full, key_ids, start), hours)
    merge(store, hermes_events(key_ids, start), hours)
    save(STORE, store)
    today = date.today()
    window = [(today - timedelta(days=back)).isoformat() for back in range(WINDOW_DAYS - 1, -1, -1)]
    sources = build_sources(key_paths)
    books = (load(HISTORY, {}), store)
    for source in sources:
        source["tokens"] = source_tokens(store, window, source["id"], hours)
        if source["kind"] == "subscription":
            source["history"] = subscription_history(books, source, today)
    report = {
        "fetched_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "since": start.isoformat() if start else None,
        "window": window,
        "sources": sources,
        "months": month_buckets(store, [source["id"] for source in sources]),
    }
    temporary = OUTPUT.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(report, indent=2))
    temporary.replace(OUTPUT)


if __name__ == "__main__":
    main()
